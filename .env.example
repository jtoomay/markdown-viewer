# Copy to .env.local and fill in. All values are public client config —
# they ship in the browser bundle. Server API keys must never live here.
VITE_APPWRITE_ENDPOINT=https://<REGION>.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=
VITE_APPWRITE_DATABASE_ID=markdown-viewer
VITE_APPWRITE_TABLE_DOCUMENTS=documents
VITE_APPWRITE_BUCKET_AVATARS=avatars
